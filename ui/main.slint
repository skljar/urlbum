import { Button, ListView, HorizontalBox, VerticalBox, LineEdit, CheckBox, TabWidget } from "std-widgets.slint";

struct RecentDb  { title: string, path: string }
struct DupGroup  { url: string, count: int }
struct DupItem   { id: int, title: string, url: string, folder: string, created: string }

// Универсальный узел: используется и в левом дереве, и в правом списке
struct TreeItem {
    id: int,
    title: string,
    depth: int,
    expanded: bool,
    is_folder: bool,
    url: string,
    favicon: image,
    has_favicon: bool,
}

// Кнопка тулбара с hover-подсветкой и tooltip
component TBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip: "";
    in property <bool>   enabled: true;
    callback clicked;
    callback hovered(string, float, float);

    width: 28px; height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: ta.has-hover ? #6688aa : #c0c8d0;
    background: !root.enabled ? #f0f0f0
              : ta.pressed     ? #b4cee0
              : ta.has-hover   ? #d8eaf8
              :                  #ececec;

    Image {
        source: root.icon;
        width: 16px; height: 16px;
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => {
            root.hovered(
                self.has-hover ? root.tip : "",
                (self.absolute-position.x + self.mouse-x) / 1px,
                (self.absolute-position.y + self.mouse-y) / 1px
            );
        }
    }
}

export component AppWindow inherits Window {
    title: "URLbum";
    min-width: 800px;
    min-height: 500px;

    // --- Модели ---
    in property <[TreeItem]> tree-model;      // левое дерево
    in property <[TreeItem]> contents-model;  // правая панель (список)

    // --- Выделение ---
    in-out property <int>  selected-id: -1;   // подсвечен в дереве
    in-out property <int>  status-id: -1;     // выделена строка в списке (одиночный клик)

    // --- Режим правой панели ---
    in-out property <bool>   show-card: false;
    in-out property <int>    card-id: -1;
    in-out property <string> card-title;
    in-out property <string> card-url;

    // --- Статусбар ---
    in-out property <bool>   status-visible: false;
    in-out property <string> status-url;
    in-out property <string> status-note;
    in-out property <string> status-created;
    in-out property <string> status-visited;

    // --- Диалог свойств ---
    in-out property <int>    prop-id: -1;
    in-out property <string> prop-title;
    in-out property <string> prop-url;
    in-out property <string> prop-note;
    in-out property <bool>   prop-is-folder: false;
    in-out property <bool>   prop-is-new: false;       // true = создание, false = редактирование
    in-out property <bool>   prop-visible: false;

    // --- Контекстное меню ---
    in-out property <bool>  ctx-visible: false;
    in-out property <int>   ctx-id: -1;
    in-out property <bool>  ctx-is-folder: false;
    in-out property <float> ctx-x: 0;   // позиция курсора в координатах окна
    in-out property <float> ctx-y: 0;

    // --- Callbacks ---
    callback new-folder();
    callback new-bookmark();
    callback delete-selected();
    callback tree-toggle-expand(int);
    callback tree-item-clicked(int, bool);
    callback tree-item-activated(int, bool);
    callback list-item-clicked(int, bool);
    callback list-item-activated(int, bool);
    callback open-properties(int);
    callback save-properties();
    callback cancel-properties();
    callback ctx-request(int, bool);        // ПКМ: id, is_folder
    callback ctx-open-browser(int);         // открыть ссылку в браузере
    callback ctx-load-favicons-folder(int); // ПКМ папки → загрузить favicon'ы рекурсивно
    callback ctx-load-favicon-bm(int);      // ПКМ ссылки → загрузить favicon
    callback favicon-done();                // вызывается из invoke_from_event_loop по завершении
    callback import-ua-dat();               // импорт из ua.dat
    callback import-done();                 // вызывается из invoke_from_event_loop по завершении
    callback quit-app();
    callback copy-url();
    callback expand-all();
    callback collapse-all();
    callback backup-db();
    callback open-db();
    callback create-db();
    callback close-db();
    callback open-recent(string);
    in property <[RecentDb]> recent-dbs: [];
    callback show-db-props();
    in-out property <bool>   db-props-visible: false;
    in-out property <string> db-props-path: "";
    in-out property <string> db-props-size: "";
    in-out property <int>    db-props-folders: 0;
    in-out property <int>    db-props-bookmarks: 0;

    // --- Прогресс импорта ---
    in-out property <bool>   import-in-progress: false;
    in-out property <string> import-status: "";

    // --- Ширина левой панели (splitter) ---
    in-out property <length> tree-width: 250px;

    // --- Статусбар окна ---
    in property <int>    status-count: 0;
    in property <string> db-name: "album.db";

    // --- Диалог дубликатов ---
    in-out property <bool>       dup-visible: false;
    in property    <[DupGroup]>  dup-groups;
    in property    <[DupItem]>   dup-items;
    in-out property <string>     dup-selected-url: "";
    in-out property <int>        dup-selected-item-id: -1;
    in-out property <int>        dup-groups-count: 0;
    in-out property <int>        dup-copies-count: 0;
    in-out property <int>        dup-extras-count: 0;
    in-out property <int>        dup-items-count: 0;       // для confirmation
    in-out property <bool>       dup-confirm-visible: false;
    in-out property <bool>       dup-confirm-all-visible: false;
    // Ширины splitter-ов диалога
    in-out property <length>     dup-groups-width:     260px;
    in-out property <length>     dup-col-title-width:  170px;
    in-out property <length>     dup-col-url-width:    160px;
    in-out property <length>     dup-col-folder-width: 160px;
    callback dup-group-clicked(string);
    callback dup-delete-selected();
    callback dup-keep-one();
    callback dup-delete-all();
    callback dup-close();

    // --- Поиск ---
    in-out property <bool>      search-visible: false;
    in-out property <bool>      search-is-duplicates: false;
    in-out property <string>    search-query: "";
    in property    <[TreeItem]> search-model;
    callback search-changed(string);
    callback search-result-activated(int);
    callback close-search();
    callback find-duplicates();

    // --- Настройки ---
    in-out property <bool>   settings-visible: false;
    in-out property <bool>   settings-toolbar-visible: true;
    in-out property <bool>   settings-show-toolbar: true;
    in-out property <bool>   settings-collapse-siblings: false;
    in-out property <bool>   settings-confirm-delete: true;
    in-out property <bool>   settings-no-duplicate-urls: false;
    in-out property <string> settings-db-path: "";
    callback settings-open();
    callback settings-save();
    callback settings-cancel();

    // --- Подтверждение удаления ---
    in-out property <bool> delete-confirm-visible: false;
    callback request-delete();

    // --- Ошибка в диалоге свойств ---
    in-out property <string> prop-error: "";

    // --- Tooltip тулбара ---
    property <string> toolbar-tip: "";
    property <float>  toolbar-tip-x: 0;
    property <float>  toolbar-tip-y: 0;

    // --- Ширина колонки "Название" в правой панели ---
    in-out property <length> col-name-width: 220px;

    // ══ Меню ════════════════════════════════════════════════════════════════════
    MenuBar {

        // ── Файл ──────────────────────────────────────────────────────────────
        Menu {
            title: "Файл";

            Menu {
                title: "Импорт";
                MenuItem {
                    title: "Импорт из ua.dat...";
                    enabled: !root.import-in-progress;
                    activated => { root.import-ua-dat(); }
                }
                MenuItem { title: "Импорт из браузера..."; enabled: false; }
                MenuItem { title: "Импорт из HTML...";     enabled: false; }
                MenuItem { title: "Импорт из TXT...";      enabled: false; }
                MenuSeparator {}
                MenuItem { title: "Экспорт в HTML..."; enabled: false; }
                MenuItem { title: "Экспорт в TXT...";  enabled: false; }
            }

            MenuSeparator {}
            MenuItem { title: "Создать базу данных..."; activated => { root.create-db(); } }
            MenuItem { title: "Открыть базу данных..."; activated => { root.open-db(); } }
            Menu {
                title: "Последние базы";
                for db in root.recent-dbs: MenuItem {
                    title: db.title;
                    activated => { root.open-recent(db.path); }
                }
            }
            MenuItem { title: "Закрыть базу"; activated => { root.close-db(); } }
            MenuSeparator {}
            MenuItem { title: "Резервная копия..."; activated => { root.backup-db(); } }
            MenuSeparator {}
            MenuItem { title: "Свойства базы данных"; activated => { root.show-db-props(); } }
            MenuSeparator {}
            MenuItem { title: "Настройки..."; activated => { root.settings-open(); } }
            MenuSeparator {}
            MenuItem { title: "Выход"; activated => { root.quit-app(); } }
        }

        // ── Ссылки ────────────────────────────────────────────────────────────
        Menu {
            title: "Ссылки";

            MenuItem { title: "Новая папка";              activated => { root.new-folder();   } }
            MenuItem { title: "Новая ссылка";             activated => { root.new-bookmark(); } }
            MenuSeparator {}
            MenuItem { title: "Удалить";                  activated => { root.request-delete(); } }
            MenuSeparator {}
            MenuItem { title: "Открыть";                  activated => { root.ctx-open-browser(root.selected-id); } }
            MenuItem { title: "Открыть с помощью...";     enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Копировать URL"; activated => { root.copy-url(); } }
            MenuItem { title: "Свойства";                 activated => { root.open-properties(root.selected-id); } }
        }

        // ── Поиск ─────────────────────────────────────────────────────────────
        Menu {
            title: "Поиск";
            MenuItem {
                title: "Найти...";
                activated => { root.search-visible = true; root.search-is-duplicates = false; }
            }
            MenuItem {
                title: "Найти дубликаты";
                activated => { root.find-duplicates(); }
            }
        }

        // ── Вид ───────────────────────────────────────────────────────────────
        Menu {
            title: "Вид";
            MenuItem { title: "Развернуть все папки"; activated => { root.expand-all(); } }
            MenuItem { title: "Свернуть все папки";   activated => { root.collapse-all(); } }
            MenuSeparator {}
            MenuItem { title: "Светлая/Тёмная тема";  enabled: false; }
        }
    }

    VerticalBox {
        // Тулбар
        if root.settings-toolbar-visible: HorizontalBox {
            height: 40px;
            TBtn { icon: @image-url("../assets/new-folder.svg"); tip: "Новая папка";       hovered(t,x,y) => { root.toolbar-tip=t; root.toolbar-tip-x=x; root.toolbar-tip-y=y; } clicked => { root.new-folder();       } }
            TBtn { icon: @image-url("../assets/new-link.svg");   tip: "Новая ссылка";     hovered(t,x,y) => { root.toolbar-tip=t; root.toolbar-tip-x=x; root.toolbar-tip-y=y; } clicked => { root.new-bookmark();     } }
            TBtn { icon: @image-url("../assets/delete.svg");     tip: "Удалить";          hovered(t,x,y) => { root.toolbar-tip=t; root.toolbar-tip-x=x; root.toolbar-tip-y=y; } clicked => { root.request-delete();   } }
            TBtn { icon: @image-url("../assets/import.svg");     tip: "Импорт из ua.dat"; enabled: !root.import-in-progress; hovered(t,x,y) => { root.toolbar-tip=t; root.toolbar-tip-x=x; root.toolbar-tip-y=y; } clicked => { root.import-ua-dat(); } }
            Text { text: root.import-status; vertical-alignment: center; color: #555555; font-size: 12px; }
            Rectangle { horizontal-stretch: 1; }
        }

        // Строка поиска
        if root.search-visible: HorizontalBox {
            height: 34px;
            spacing: 6px;
            Text {
                text: root.search-is-duplicates ? "Дубликаты:" : "Поиск:";
                vertical-alignment: center;
                width: 80px;
            }
            if !root.search-is-duplicates: LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Введите текст...";
                text <=> root.search-query;
                edited(q) => { root.search-changed(q); }
            }
            if root.search-is-duplicates: Rectangle { horizontal-stretch: 1; }
            Button { text: "✕"; width: 32px; clicked => { root.close-search(); } }
        }

        // Основная область
        HorizontalLayout {

            // ══ Левая панель — смешанное дерево ══
            Rectangle {
                width: root.tree-width;

                ListView {
                    for item in root.tree-model: Rectangle {
                        height: 28px;
                        background: item.id == root.selected-id ? #d0e4ff : transparent;

                        HorizontalLayout {
                            padding-left: item.depth * 16px;

                            // Зона иконки папки — только для папок, 22px
                            if item.is_folder: TouchArea {
                                width: 22px;
                                clicked => { root.tree-toggle-expand(item.id); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: item.expanded
                                            ? @image-url("../assets/folder-open.png")
                                            : @image-url("../assets/folder-closed.png");
                                        image-rendering: pixelated;
                                        width: 18px;
                                        height: 16px;
                                    }
                                }
                            }

                            // Зона названия — одиночный и двойной клик
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked        => { root.tree-item-clicked(item.id, item.is_folder);   }
                                double-clicked => { root.tree-item-activated(item.id, item.is_folder); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 4px;
                                    spacing: 4px;
                                    // Иконка ссылки: favicon или new-link.svg
                                    if !item.is_folder: Rectangle {
                                        width: 16px;
                                        if item.has_favicon: Image {
                                            source: item.favicon;
                                            width: 14px; height: 14px;
                                            x: 1px;
                                            y: (parent.height - 14px) / 2;
                                            image-rendering: pixelated;
                                        }
                                        if !item.has_favicon: Image {
                                            source: @image-url("../assets/new-link.svg");
                                            width: 14px; height: 14px;
                                            x: 1px;
                                            y: (parent.height - 14px) / 2;
                                        }
                                    }
                                    Text {
                                        text: item.title;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ Разделитель (перетаскиваемый) ══
            Rectangle {
                width: 4px;
                background: #e0e0e0;
                TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        root.tree-width = max(120px, min(600px, root.tree-width + self.mouse-x));
                    }
                }
            }

            // ══ Правая панель — список или карточка ══
            right-panel := Rectangle {
                horizontal-stretch: 1;

                VerticalLayout {

                    // ПОИСК — результаты
                    if root.search-visible: ListView {
                        vertical-stretch: 1;
                        for item in root.search-model: Rectangle {
                            height: 28px;
                            background: item.id == root.status-id ? #d0e4ff : transparent;

                            HorizontalLayout {
                                padding: 0px;
                                spacing: 0px;
                                Rectangle {
                                    width: root.col-name-width;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 4px;
                                        if item.has_favicon: Image {
                                            source: item.favicon;
                                            width: 14px; height: 14px;
                                            y: (parent.height - 14px) / 2;
                                            image-rendering: pixelated;
                                        }
                                        if !item.has_favicon: Image {
                                            source: @image-url("../assets/new-link.svg");
                                            width: 14px; height: 14px;
                                            y: (parent.height - 14px) / 2;
                                        }
                                        Text {
                                            text: item.title;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                Rectangle { width: 5px; background: #e8eaf0; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    Text {
                                        text: item.url;
                                        color: #0055cc;
                                        font-size: 12px;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            TouchArea {
                                clicked        => { root.list-item-clicked(item.id, false); }
                                double-clicked => { root.search-result-activated(item.id); }
                            }
                        }
                    }

                    // СПИСОК — заголовки колонок (show-card = false)
                    if !root.show-card && !root.search-visible: Rectangle {
                        height: 22px;
                        background: #f0f0f0;
                        border-color: #d0d0d0;
                        border-width: 1px;
                        HorizontalLayout {
                            padding: 0px;
                            spacing: 0px;
                            Rectangle {
                                width: root.col-name-width;
                                Text { text: "Название"; font-size: 11px; color: #555555; x: 6px; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 5px;
                                background: col-spl.has-hover ? #0078d4 : #c0c8d0;
                                col-spl := TouchArea {
                                    mouse-cursor: col-resize;
                                    moved => {
                                        root.col-name-width = max(80px, min(right-panel.width - 100px, root.col-name-width + self.mouse-x));
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Text { text: "Адрес"; font-size: 11px; color: #555555; x: 6px; vertical-alignment: center; }
                            }
                        }
                    }

                    // СПИСОК — строки (show-card = false)
                    if !root.show-card && !root.search-visible: ListView {
                        vertical-stretch: 1;
                        for item in root.contents-model: Rectangle {
                            height: 28px;
                            background: item.id == root.status-id ? #d0e4ff : transparent;

                            HorizontalLayout {
                                padding: 0px;
                                spacing: 0px;

                                // Колонка Название (фиксированная ширина, обрезается)
                                Rectangle {
                                    width: root.col-name-width;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 4px;
                                        // Иконка: ▶ для папки, favicon/new-link для ссылки
                                        if item.is_folder: Text {
                                            text: "▶";
                                            color: #0055aa;
                                            width: 14px;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                        if !item.is_folder: Rectangle {
                                            width: 14px;
                                            if item.has_favicon: Image {
                                                source: item.favicon;
                                                width: 14px; height: 14px;
                                                y: (parent.height - 14px) / 2;
                                                image-rendering: pixelated;
                                            }
                                            if !item.has_favicon: Image {
                                                source: @image-url("../assets/new-link.svg");
                                                width: 14px; height: 14px;
                                                y: (parent.height - 14px) / 2;
                                            }
                                        }
                                        Text {
                                            text: item.title;
                                            font-weight: item.is_folder ? 700 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                // Разделитель
                                Rectangle { width: 5px; background: #e8eaf0; }

                                // Колонка Адрес (растягивается)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    Text {
                                        text: item.url;
                                        color: #0055cc;
                                        font-size: 12px;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            TouchArea {
                                clicked        => { root.list-item-clicked(item.id, item.is_folder);   }
                                double-clicked => { root.list-item-activated(item.id, item.is_folder); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                            }
                        }
                    }

                    // СТАТУСБАР (только в режиме списка, при выбранной ссылке)
                    if !root.show-card && !root.search-visible && root.status-visible: Rectangle {
                        height: 58px;
                        background: #f5f5f5;
                        border-color: #cccccc;
                        border-width: 1px;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            Text {
                                text: root.status-url;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: root.status-note;
                                font-size: 11px;
                                color: #555555;
                                overflow: elide;
                            }
                            Text {
                                text: "Добавлено: " + root.status-created
                                    + "  Рисунок: —  Визит: " + root.status-visited;
                                font-size: 10px;
                                color: #888888;
                            }
                        }
                    }

                    // КАРТОЧКА (show-card = true)
                    if root.show-card: VerticalBox {
                        vertical-stretch: 1;
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.card-title;
                            font-size: 18px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.card-url;
                            color: #0066cc;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 200px;
                            background: #e8e8e8;
                            border-radius: 4px;
                            border-color: #cccccc;
                            border-width: 1px;
                            Text {
                                text: "[ превью ]";
                                color: #aaaaaa;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        // Edit… убран — свойства через ПКМ
                    }

                } // VerticalLayout
            } // Rectangle правая панель
        } // HorizontalLayout основная область

        // ── Статусбар окна ────────────────────────────────────────────────────
        Rectangle {
            height: 22px;
            background: #f0f0f0;
            border-color: #d0d0d0;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: "Записей: " + root.status-count + "  |  База: " + root.db-name;
                    font-size: 11px;
                    color: #555555;
                    vertical-alignment: center;
                }
            }
        }

    } // VerticalBox корень

    // ══ Контекстное меню — оверлей у курсора ══
    if root.ctx-visible: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        // Подложка: клик вне меню — закрыть
        TouchArea { clicked => { root.ctx-visible = false; } }

        // Само меню — у курсора, с clamp по краям окна
        Rectangle {
            x: min(root.ctx-x * 1px, root.width  - self.width  - 4px);
            y: min(root.ctx-y * 1px, root.height - self.height - 4px);
            width: 180px;
            height: root.ctx-is-folder ? 142px : 114px;
            background: #ffffff;
            border-color: #aaaaaa;
            border-width: 1px;
            border-radius: 3px;

            VerticalLayout {

                // ── Меню ПАПКИ ──
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.new-folder();     root.ctx-visible = false; } }
                    Text { x: 12px; text: "Новая папка";  vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.new-bookmark();   root.ctx-visible = false; } }
                    Text { x: 12px; text: "Новая ссылка"; vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.ctx-load-favicons-folder(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Обновить favicon'ы"; vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.open-properties(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Свойства";    vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.request-delete(); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Удалить"; color: #cc2222; vertical-alignment: center; height: 28px; }
                }

                // ── Меню ССЫЛКИ ──
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.ctx-open-browser(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Открыть";     vertical-alignment: center; height: 28px; }
                }
                if !root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.ctx-load-favicon-bm(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Загрузить favicon"; vertical-alignment: center; height: 28px; }
                }
                if !root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.open-properties(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Свойства";    vertical-alignment: center; height: 28px; }
                }
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.request-delete(); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Удалить"; color: #cc2222; vertical-alignment: center; height: 28px; }
                }
            }
        }
    }

    // ══ Диалог свойств — модальный оверлей ══
    if root.prop-visible: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: #00000055;

        TouchArea { /* поглощает клики на подложку */ }

        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 420px;
            height: root.prop-is-folder ? 195px : 230px;
            background: #f5f5f5;
            border-radius: 8px;
            border-color: #aaaaaa;
            border-width: 1px;

            VerticalBox {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: root.prop-is-new
                        ? (root.prop-is-folder ? "Новая папка" : "Новая ссылка")
                        : (root.prop-is-folder ? "Folder Properties" : "Bookmark Properties");
                    font-size: 14px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Title:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-title; }
                }

                if !root.prop-is-folder: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "URL:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-url; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Note:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-note; }
                }

                if root.prop-error != "": Text {
                    text: root.prop-error;
                    color: #cc2222;
                    font-size: 12px;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "OK";     clicked => { root.save-properties();   } }
                    Button { text: "Cancel"; clicked => { root.cancel-properties(); } }
                }
            }
        }
    }

    // ══ Диалог свойств базы данных ════════════════════════════════════════════
    if root.db-props-visible: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: #00000055;
        TouchArea { clicked => { root.db-props-visible = false; } }
        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 440px;
            height: 190px;
            background: #f5f5f5;
            border-radius: 8px;
            border-color: #aaaaaa;
            border-width: 1px;
            VerticalBox {
                padding: 20px;
                spacing: 8px;
                Text { text: "Свойства базы данных"; font-size: 14px; font-weight: 700; }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Путь:";      width: 80px; color: #555; vertical-alignment: center; }
                    Text { text: root.db-props-path; overflow: elide; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Размер:";    width: 80px; color: #555; vertical-alignment: center; }
                    Text { text: root.db-props-size; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Папок:";     width: 80px; color: #555; vertical-alignment: center; }
                    Text { text: root.db-props-folders; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Ссылок:";    width: 80px; color: #555; vertical-alignment: center; }
                    Text { text: root.db-props-bookmarks; vertical-alignment: center; }
                }
                HorizontalLayout { alignment: end;
                    Button { text: "ОК"; clicked => { root.db-props-visible = false; } }
                }
            }
        }
    }

    // ══ Диалог дубликатов ════════════════════════════════════════════════════
    if root.dup-visible: Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        background: #00000055;
        TouchArea { /* поглощает клики на подложку */ }

        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 820px; height: 500px;
            background: #f5f5f5;
            border-radius: 6px;
            border-color: #aaaaaa;
            border-width: 1px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // Заголовок + сводка
                Text { text: "Поиск дубликатов ссылок"; font-size: 14px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 16px;
                    Text { text: "Групп: "  + root.dup-groups-count; font-size: 12px; color: #444; }
                    Text { text: "Копий: "  + root.dup-copies-count; font-size: 12px; color: #444; }
                    Text { text: "Лишних: " + root.dup-extras-count; font-size: 12px; color: #cc4444; }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Основная панель: левая (группы) + splitter + правая (копии)
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // ── Левая: группы URL ──
                    Rectangle {
                        width: root.dup-groups-width;
                        border-color: #cccccc; border-width: 1px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 0px;
                            Rectangle {
                                height: 22px; background: #e8e8e8;
                                Text { x: 6px; text: "Группы URL"; font-size: 11px; color: #555; vertical-alignment: center; }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for g in root.dup-groups: Rectangle {
                                    height: 26px;
                                    background: g.url == root.dup-selected-url ? #d0e4ff : transparent;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 4px; spacing: 4px;
                                        Text {
                                            text: g.url; font-size: 11px;
                                            vertical-alignment: center; overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 28px; background: #0078d4; border-radius: 9px;
                                            Text {
                                                text: g.count; color: #ffffff;
                                                font-size: 10px; font-weight: 700;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                    TouchArea { clicked => { root.dup-group-clicked(g.url); } }
                                }
                            }
                        }
                    }

                    // ── Splitter между панелями ──
                    Rectangle {
                        width: 4px;
                        background: dup-panel-spl.has-hover ? #0078d4 : #e0e0e0;
                        dup-panel-spl := TouchArea {
                            mouse-cursor: col-resize;
                            moved => {
                                root.dup-groups-width = max(150px, min(450px, root.dup-groups-width + self.mouse-x));
                            }
                        }
                    }

                    // ── Правая: копии выбранной группы ──
                    Rectangle {
                        horizontal-stretch: 1;
                        border-color: #cccccc; border-width: 1px;
                        background: #ffffff;
                        VerticalLayout {
                            padding: 0px;
                            // Заголовок панели
                            Rectangle {
                                height: 22px; background: #e8e8e8;
                                Text {
                                    x: 6px;
                                    text: root.dup-selected-url == ""
                                        ? "Дубликаты"
                                        : "Дубликаты (" + root.dup-items-count + ")";
                                    font-size: 11px; color: #555; vertical-alignment: center;
                                }
                            }
                            // Заголовки колонок с splitter'ами
                            Rectangle {
                                height: 20px; background: #f0f0f0;
                                HorizontalLayout {
                                    padding-left: 6px; spacing: 0px;
                                    Rectangle {
                                        width: root.dup-col-title-width; clip: true;
                                        Text { x: 0; text: "Название"; font-size: 10px; color: #666; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 5px;
                                        background: spl-title.has-hover ? #0078d4 : #c0c8d0;
                                        spl-title := TouchArea {
                                            mouse-cursor: col-resize;
                                            moved => { root.dup-col-title-width = max(60px, min(320px, root.dup-col-title-width + self.mouse-x)); }
                                        }
                                    }
                                    Rectangle {
                                        width: root.dup-col-url-width; clip: true;
                                        Text { x: 0; text: "URL"; font-size: 10px; color: #666; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 5px;
                                        background: spl-url.has-hover ? #0078d4 : #c0c8d0;
                                        spl-url := TouchArea {
                                            mouse-cursor: col-resize;
                                            moved => { root.dup-col-url-width = max(60px, min(320px, root.dup-col-url-width + self.mouse-x)); }
                                        }
                                    }
                                    Rectangle {
                                        width: root.dup-col-folder-width; clip: true;
                                        Text { x: 0; text: "Папка"; font-size: 10px; color: #666; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        width: 5px;
                                        background: spl-folder.has-hover ? #0078d4 : #c0c8d0;
                                        spl-folder := TouchArea {
                                            mouse-cursor: col-resize;
                                            moved => { root.dup-col-folder-width = max(60px, min(320px, root.dup-col-folder-width + self.mouse-x)); }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Text { x: 0; text: "Дата"; font-size: 10px; color: #666; vertical-alignment: center; }
                                    }
                                }
                            }
                            // Строки копий
                            ListView {
                                vertical-stretch: 1;
                                for item in root.dup-items: Rectangle {
                                    height: 26px;
                                    background: item.id == root.dup-selected-item-id ? #d0e4ff : transparent;
                                    HorizontalLayout {
                                        padding-left: 6px; spacing: 0px;
                                        Rectangle { width: root.dup-col-title-width; clip: true;
                                            Text { x: 0; text: item.title; font-size: 11px; vertical-alignment: center; overflow: elide; width: parent.width; }
                                        }
                                        Rectangle { width: 5px; background: #e8eaf0; }
                                        Rectangle { width: root.dup-col-url-width; clip: true;
                                            Text { x: 0; text: item.url; font-size: 11px; color: #0055cc; vertical-alignment: center; overflow: elide; width: parent.width; }
                                        }
                                        Rectangle { width: 5px; background: #e8eaf0; }
                                        Rectangle { width: root.dup-col-folder-width; clip: true;
                                            Text { x: 0; text: item.folder; font-size: 11px; color: #555; vertical-alignment: center; overflow: elide; width: parent.width; }
                                        }
                                        Rectangle { width: 5px; background: #e8eaf0; }
                                        Rectangle { horizontal-stretch: 1; clip: true;
                                            Text { x: 0; text: item.created; font-size: 11px; color: #555; vertical-alignment: center; overflow: elide; width: parent.width; }
                                        }
                                    }
                                    TouchArea { clicked => { root.dup-selected-item-id = item.id; } }
                                }
                            }
                        }
                    }
                }

                // Кнопки
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Удалить выбранный";
                        enabled: root.dup-selected-item-id != -1;
                        clicked => { root.dup-delete-selected(); }
                    }
                    Button {
                        text: "Оставить одну ссылку";
                        enabled: root.dup-selected-url != "";
                        clicked => { root.dup-confirm-visible = true; }
                    }
                    Button {
                        text: "Удалить все дубликаты";
                        enabled: root.dup-extras-count > 0;
                        clicked => { root.dup-confirm-all-visible = true; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Закрыть"; clicked => { root.dup-close(); } }
                }
            }

            // Confirmation overlay — "Оставить одну ссылку"
            if root.dup-confirm-visible: Rectangle {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                background: #00000044;
                TouchArea { /* блокировать клики */ }

                Rectangle {
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    width: 360px; height: 120px;
                    background: #f5f5f5;
                    border-radius: 6px;
                    border-color: #aaaaaa;
                    border-width: 1px;

                    VerticalBox {
                        padding: 16px; spacing: 12px;
                        Text {
                            text: "Будет удалено " + (root.dup-items-count - 1) + " копий. Продолжить?";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: end; spacing: 8px;
                            Button {
                                text: "Да";
                                clicked => {
                                    root.dup-confirm-visible = false;
                                    root.dup-keep-one();
                                }
                            }
                            Button {
                                text: "Отмена";
                                clicked => { root.dup-confirm-visible = false; }
                            }
                        }
                    }
                }
            }

            // Confirmation overlay — "Удалить все дубликаты"
            if root.dup-confirm-all-visible: Rectangle {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                background: #00000044;
                TouchArea { /* блокировать клики */ }
                Rectangle {
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    width: 400px; height: 130px;
                    background: #f5f5f5;
                    border-radius: 6px;
                    border-color: #aaaaaa;
                    border-width: 1px;
                    VerticalBox {
                        padding: 16px; spacing: 12px;
                        Text {
                            text: "Будет удалено " + root.dup-extras-count
                                + " лишних копий из всей базы. Продолжить?";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: end; spacing: 8px;
                            Button {
                                text: "Да";
                                clicked => {
                                    root.dup-confirm-all-visible = false;
                                    root.dup-delete-all();
                                }
                            }
                            Button {
                                text: "Отмена";
                                clicked => { root.dup-confirm-all-visible = false; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ══ Диалог подтверждения удаления ════════════════════════════════════════
    if root.delete-confirm-visible: Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        background: #00000055;
        TouchArea { /* поглощает клики */ }
        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 320px; height: 110px;
            background: #f5f5f5;
            border-radius: 6px;
            border-color: #aaaaaa;
            border-width: 1px;
            VerticalBox {
                padding: 16px; spacing: 12px;
                Text { text: "Удалить выбранный элемент?"; font-size: 13px; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Button {
                        text: "Да";
                        clicked => {
                            root.delete-confirm-visible = false;
                            root.delete-selected();
                        }
                    }
                    Button {
                        text: "Отмена";
                        clicked => { root.delete-confirm-visible = false; }
                    }
                }
            }
        }
    }

    // ══ Диалог настроек ═══════════════════════════════════════════════════════
    if root.settings-visible: Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        background: #00000055;
        TouchArea { /* поглощает клики */ }
        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 460px; height: 340px;
            background: #f5f5f5;
            border-radius: 8px;
            border-color: #aaaaaa;
            border-width: 1px;
            VerticalBox {
                padding: 16px; spacing: 12px;
                Text { text: "Настройки"; font-size: 14px; font-weight: 700; }
                TabWidget {
                    vertical-stretch: 1;

                    Tab {
                        title: "Общие";
                        VerticalBox {
                            padding: 12px; spacing: 8px;

                            Text { text: "ВИД"; font-size: 11px; font-weight: 700; color: #555555; }
                            CheckBox {
                                text: "Показывать toolbar";
                                checked <=> root.settings-show-toolbar;
                            }

                            Text { text: "ДЕРЕВО ПАПОК"; font-size: 11px; font-weight: 700; color: #555555; }
                            CheckBox {
                                text: "Сворачивать другие ветки при открытии";
                                checked <=> root.settings-collapse-siblings;
                            }

                            Text { text: "ЗАКЛАДКИ"; font-size: 11px; font-weight: 700; color: #555555; }
                            CheckBox {
                                text: "Подтверждать удаление";
                                checked <=> root.settings-confirm-delete;
                            }
                            CheckBox {
                                text: "Запретить повторяющиеся ссылки";
                                checked <=> root.settings-no-duplicate-urls;
                            }

                            Rectangle { vertical-stretch: 1; }

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "База данных:";
                                    font-size: 11px; color: #555555;
                                    vertical-alignment: center;
                                    width: 100px;
                                }
                                Text {
                                    text: root.settings-db-path;
                                    font-size: 11px; color: #333333;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    Tab {
                        title: "Прокси";
                        Rectangle {
                            Text {
                                text: "(будет добавлено вместе с проверкой ссылок)";
                                color: #888888; font-size: 12px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }

                    Tab {
                        title: "Рисунок";
                        Rectangle {
                            Text {
                                text: "(будет добавлено вместе со скриншотами)";
                                color: #888888; font-size: 12px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Button { text: "ОК";     clicked => { root.settings-save();   } }
                    Button { text: "Отмена"; clicked => { root.settings-cancel(); } }
                }
            }
        }
    }

    // ══ Tooltip тулбара ═══════════════════════════════════════════════════════
    if root.toolbar-tip != "": Rectangle {
        x: root.toolbar-tip-x * 1px;
        y: (root.toolbar-tip-y + 18) * 1px;
        z: 500;
        height: 20px;
        width: tip-lbl.preferred-width + 12px;
        background: #ffffe1;
        border-color: #999999;
        border-width: 1px;
        tip-lbl := Text {
            text: root.toolbar-tip;
            color: #000000;
            font-size: 11px;
            x: 6px; y: 3px;
        }
    }
}
