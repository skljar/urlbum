import { Button, ListView, HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

// Универсальный узел: используется и в левом дереве, и в правом списке
struct TreeItem {
    id: int,
    title: string,
    depth: int,
    expanded: bool,
    is_folder: bool,
    url: string,
}

export component AppWindow inherits Window {
    title: "URLbum";
    min-width: 800px;
    min-height: 500px;

    // --- Модели ---
    in property <[TreeItem]> tree-model;      // левое дерево
    in property <[TreeItem]> contents-model;  // правая панель (список)

    // --- Выделение ---
    in-out property <int>  selected-id: -1;   // подсвечен в дереве
    in-out property <int>  status-id: -1;     // выделена строка в списке (одиночный клик)

    // --- Режим правой панели ---
    in-out property <bool>   show-card: false;
    in-out property <int>    card-id: -1;
    in-out property <string> card-title;
    in-out property <string> card-url;

    // --- Статусбар ---
    in-out property <bool>   status-visible: false;
    in-out property <string> status-url;
    in-out property <string> status-note;
    in-out property <string> status-created;
    in-out property <string> status-visited;

    // --- Диалог свойств ---
    in-out property <int>    prop-id: -1;
    in-out property <string> prop-title;
    in-out property <string> prop-url;
    in-out property <string> prop-note;
    in-out property <bool>   prop-is-folder: false;
    in-out property <bool>   prop-is-new: false;       // true = создание, false = редактирование
    in-out property <bool>   prop-visible: false;

    // --- Контекстное меню ---
    in-out property <bool>  ctx-visible: false;
    in-out property <int>   ctx-id: -1;
    in-out property <bool>  ctx-is-folder: false;
    in-out property <float> ctx-x: 0;   // позиция курсора в координатах окна
    in-out property <float> ctx-y: 0;

    // --- Callbacks ---
    callback new-folder();
    callback new-bookmark();
    callback delete-selected();
    callback tree-toggle-expand(int);
    callback tree-item-clicked(int, bool);
    callback tree-item-activated(int, bool);
    callback list-item-clicked(int, bool);
    callback list-item-activated(int, bool);
    callback open-properties(int);
    callback save-properties();
    callback cancel-properties();
    callback ctx-request(int, bool);        // ПКМ: id, is_folder
    callback ctx-open-browser(int);         // открыть ссылку в браузере
    callback import-ua-dat();               // импорт из ua.dat
    callback import-done();                 // вызывается из invoke_from_event_loop по завершении

    // --- Прогресс импорта ---
    in-out property <bool>   import-in-progress: false;
    in-out property <string> import-status: "";

    // --- Ширина левой панели (splitter) ---
    in-out property <length> tree-width: 250px;

    // --- Статусбар окна ---
    in property <int>    status-count: 0;
    in property <string> db-name: "album.db";

    // --- Ширина колонки "Название" в правой панели ---
    in-out property <length> col-name-width: 220px;

    // ══ Меню ════════════════════════════════════════════════════════════════════
    MenuBar {

        // ── Файл ──────────────────────────────────────────────────────────────
        Menu {
            title: "Файл";

            Menu {
                title: "Импорт";
                MenuItem {
                    title: "Импорт из ua.dat...";
                    enabled: !root.import-in-progress;
                    activated => { root.import-ua-dat(); }
                }
                MenuItem { title: "Импорт из браузера..."; enabled: false; }
                MenuItem { title: "Импорт из HTML...";     enabled: false; }
                MenuItem { title: "Импорт из TXT...";      enabled: false; }
                MenuSeparator {}
                MenuItem { title: "Экспорт в HTML..."; enabled: false; }
                MenuItem { title: "Экспорт в TXT...";  enabled: false; }
            }

            MenuSeparator {}
            MenuItem { title: "Создать базу данных..."; enabled: false; }
            MenuItem { title: "Открыть базу данных..."; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Свойства базы данных";   enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Настройки...";           enabled: false; }
        }

        // ── Ссылки ────────────────────────────────────────────────────────────
        Menu {
            title: "Ссылки";

            MenuItem { title: "Новая папка";              activated => { root.new-folder();   } }
            MenuItem { title: "Новая ссылка";             activated => { root.new-bookmark(); } }
            MenuSeparator {}
            MenuItem { title: "Удалить";                  activated => { root.delete-selected(); } }
            MenuSeparator {}
            MenuItem { title: "Открыть";                  activated => { root.ctx-open-browser(root.selected-id); } }
            MenuItem { title: "Открыть с помощью...";     enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Копировать URL";            enabled: false; }
            MenuItem { title: "Свойства";                 activated => { root.open-properties(root.selected-id); } }
        }

        // ── Поиск ─────────────────────────────────────────────────────────────
        Menu {
            title: "Поиск";
            MenuItem { title: "Найти..."; enabled: false; }
        }

        // ── Вид ───────────────────────────────────────────────────────────────
        Menu {
            title: "Вид";
            MenuItem { title: "Развернуть все папки"; enabled: false; }
            MenuItem { title: "Свернуть все папки";   enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Светлая/Тёмная тема";  enabled: false; }
        }
    }

    VerticalBox {
        // Тулбар
        HorizontalBox {
            height: 40px;
            Button { text: "New Folder";   clicked => { root.new-folder();      } }
            Button { text: "New Bookmark"; clicked => { root.new-bookmark();    } }
            Button { text: "Delete";       clicked => { root.delete-selected(); } }
            Button { text: "Import ua.dat"; enabled: !root.import-in-progress; clicked => { root.import-ua-dat(); } }
            Text { text: root.import-status; vertical-alignment: center; color: #555555; font-size: 12px; }
            Rectangle { horizontal-stretch: 1; }
        }

        // Основная область
        HorizontalLayout {

            // ══ Левая панель — смешанное дерево ══
            Rectangle {
                width: root.tree-width;

                ListView {
                    for item in root.tree-model: Rectangle {
                        height: 28px;
                        background: item.id == root.selected-id ? #d0e4ff : transparent;

                        HorizontalLayout {
                            padding-left: item.depth * 16px;

                            // Зона иконки папки — только для папок, 22px
                            if item.is_folder: TouchArea {
                                width: 22px;
                                clicked => { root.tree-toggle-expand(item.id); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: item.expanded
                                            ? @image-url("../assets/folder-open.png")
                                            : @image-url("../assets/folder-closed.png");
                                        image-rendering: pixelated;
                                        width: 18px;
                                        height: 16px;
                                    }
                                }
                            }

                            // Зона названия — одиночный и двойной клик
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked        => { root.tree-item-clicked(item.id, item.is_folder);   }
                                double-clicked => { root.tree-item-activated(item.id, item.is_folder); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-top: 4px;
                                    Text {
                                        text: item.is_folder ? item.title : "  • " + item.title;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ Разделитель (перетаскиваемый) ══
            Rectangle {
                width: 4px;
                background: #e0e0e0;
                TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        root.tree-width = max(120px, min(600px, root.tree-width + self.mouse-x));
                    }
                }
            }

            // ══ Правая панель — список или карточка ══
            right-panel := Rectangle {
                horizontal-stretch: 1;

                VerticalLayout {

                    // СПИСОК — заголовки колонок (show-card = false)
                    if !root.show-card: Rectangle {
                        height: 22px;
                        background: #f0f0f0;
                        border-color: #d0d0d0;
                        border-width: 1px;
                        HorizontalLayout {
                            padding: 0px;
                            spacing: 0px;
                            Rectangle {
                                width: root.col-name-width;
                                Text { text: "Название"; font-size: 11px; color: #555555; x: 6px; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 5px;
                                background: col-spl.has-hover ? #0078d4 : #c0c8d0;
                                col-spl := TouchArea {
                                    mouse-cursor: col-resize;
                                    moved => {
                                        root.col-name-width = max(80px, min(right-panel.width - 100px, root.col-name-width + self.mouse-x));
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Text { text: "Адрес"; font-size: 11px; color: #555555; x: 6px; vertical-alignment: center; }
                            }
                        }
                    }

                    // СПИСОК — строки (show-card = false)
                    if !root.show-card: ListView {
                        vertical-stretch: 1;
                        for item in root.contents-model: Rectangle {
                            height: 28px;
                            background: item.id == root.status-id ? #d0e4ff : transparent;

                            HorizontalLayout {
                                padding: 0px;
                                spacing: 0px;

                                // Колонка Название (фиксированная ширина, обрезается)
                                Rectangle {
                                    width: root.col-name-width;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 4px;
                                        Text {
                                            text: item.is_folder ? "▶" : "●";
                                            color: item.is_folder ? #0055aa : #aaaaaa;
                                            width: 14px;
                                            font-size: item.is_folder ? 10px : 8px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: item.title;
                                            font-weight: item.is_folder ? 700 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                // Разделитель
                                Rectangle { width: 5px; background: #e8eaf0; }

                                // Колонка Адрес (растягивается)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    Text {
                                        text: item.url;
                                        color: #0055cc;
                                        font-size: 12px;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            TouchArea {
                                clicked        => { root.list-item-clicked(item.id, item.is_folder);   }
                                double-clicked => { root.list-item-activated(item.id, item.is_folder); }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down {
                                        root.ctx-x = (self.absolute-position.x + self.mouse-x) / 1px;
                                        root.ctx-y = (self.absolute-position.y + self.mouse-y) / 1px;
                                        root.ctx-request(item.id, item.is_folder);
                                    }
                                }
                            }
                        }
                    }

                    // СТАТУСБАР (только в режиме списка, при выбранной ссылке)
                    if !root.show-card && root.status-visible: Rectangle {
                        height: 58px;
                        background: #f5f5f5;
                        border-color: #cccccc;
                        border-width: 1px;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            Text {
                                text: root.status-url;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: root.status-note;
                                font-size: 11px;
                                color: #555555;
                                overflow: elide;
                            }
                            Text {
                                text: "Добавлено: " + root.status-created
                                    + "  Рисунок: —  Визит: " + root.status-visited;
                                font-size: 10px;
                                color: #888888;
                            }
                        }
                    }

                    // КАРТОЧКА (show-card = true)
                    if root.show-card: VerticalBox {
                        vertical-stretch: 1;
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.card-title;
                            font-size: 18px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.card-url;
                            color: #0066cc;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 200px;
                            background: #e8e8e8;
                            border-radius: 4px;
                            border-color: #cccccc;
                            border-width: 1px;
                            Text {
                                text: "[ превью ]";
                                color: #aaaaaa;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        // Edit… убран — свойства через ПКМ
                    }

                } // VerticalLayout
            } // Rectangle правая панель
        } // HorizontalLayout основная область

        // ── Статусбар окна ────────────────────────────────────────────────────
        Rectangle {
            height: 22px;
            background: #f0f0f0;
            border-color: #d0d0d0;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: "Записей: " + root.status-count + "  |  База: " + root.db-name;
                    font-size: 11px;
                    color: #555555;
                    vertical-alignment: center;
                }
            }
        }

    } // VerticalBox корень

    // ══ Контекстное меню — оверлей у курсора ══
    if root.ctx-visible: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        // Подложка: клик вне меню — закрыть
        TouchArea { clicked => { root.ctx-visible = false; } }

        // Само меню — у курсора, с clamp по краям окна
        Rectangle {
            x: min(root.ctx-x * 1px, root.width  - self.width  - 4px);
            y: min(root.ctx-y * 1px, root.height - self.height - 4px);
            width: 160px;
            height: root.ctx-is-folder ? 113px : 85px;
            background: #ffffff;
            border-color: #aaaaaa;
            border-width: 1px;
            border-radius: 3px;

            VerticalLayout {

                // ── Меню ПАПКИ ──
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.new-folder();     root.ctx-visible = false; } }
                    Text { x: 12px; text: "Новая папка";  vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.new-bookmark();   root.ctx-visible = false; } }
                    Text { x: 12px; text: "Новая ссылка"; vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.open-properties(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Свойства";    vertical-alignment: center; height: 28px; }
                }
                if root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.delete-selected(); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Удалить"; color: #cc2222; vertical-alignment: center; height: 28px; }
                }

                // ── Меню ССЫЛКИ ──
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.ctx-open-browser(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Открыть";     vertical-alignment: center; height: 28px; }
                }
                if !root.ctx-is-folder: Rectangle { height: 1px; background: #dddddd; }
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.open-properties(root.ctx-id); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Свойства";    vertical-alignment: center; height: 28px; }
                }
                if !root.ctx-is-folder: Rectangle {
                    height: 28px;
                    TouchArea { clicked => { root.delete-selected(); root.ctx-visible = false; } }
                    Text { x: 12px; text: "Удалить"; color: #cc2222; vertical-alignment: center; height: 28px; }
                }
            }
        }
    }

    // ══ Диалог свойств — модальный оверлей ══
    if root.prop-visible: Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: #00000055;

        TouchArea { /* поглощает клики на подложку */ }

        Rectangle {
            x: (root.width  - self.width)  / 2;
            y: (root.height - self.height) / 2;
            width: 420px;
            height: root.prop-is-folder ? 195px : 230px;
            background: #f5f5f5;
            border-radius: 8px;
            border-color: #aaaaaa;
            border-width: 1px;

            VerticalBox {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: root.prop-is-new
                        ? (root.prop-is-folder ? "Новая папка" : "Новая ссылка")
                        : (root.prop-is-folder ? "Folder Properties" : "Bookmark Properties");
                    font-size: 14px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Title:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-title; }
                }

                if !root.prop-is-folder: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "URL:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-url; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Note:"; width: 50px; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; text <=> root.prop-note; }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "OK";     clicked => { root.save-properties();   } }
                    Button { text: "Cancel"; clicked => { root.cancel-properties(); } }
                }
            }
        }
    }
}
